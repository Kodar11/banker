# Supabase Cloud project. Use the PUBLISHABLE (anon) key only — never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Agora App ID for voice chat (public: every Agora client carries it). The App CERTIFICATE never
# goes here or anywhere in the app: it is a Supabase function secret (AGORA_APP_CERTIFICATE).
EXPO_PUBLIC_AGORA_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
